 220:Core/Src/bmp280.c **** /*
 221:Core/Src/bmp280.c **** This has the spi_completed guard and the t_standby_elapsed guard built in, so main.c code stays org
 222:Core/Src/bmp280.c **** will return an 8-bit hex value depening on what kind of error there is (if there is any)
 223:Core/Src/bmp280.c **** Output Codes:
 224:Core/Src/bmp280.c ****     0x0001 -> HAL transaction sucsessfull,
 225:Core/Src/bmp280.c ****     0x0002 -> SPI Bus is busy
 226:Core/Src/bmp280.c ****     0x0003 -> SPI bus returned some error
 227:Core/Src/bmp280.c ****     0x0004 -> HAL_SPI_TransmitReceive_DMA returned a timeout
 228:Core/Src/bmp280.c ****     0x0005 -> standby time not elapsed yet
 229:Core/Src/bmp280.c ****     0x0006 -> HAl function returned nothing at all
 230:Core/Src/bmp280.c **** */
