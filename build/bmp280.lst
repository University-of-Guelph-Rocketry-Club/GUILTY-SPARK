  50:Core/Src/bmp280.c **** /*
  51:Core/Src/bmp280.c **** This will configure the BMP280 registers over SPI.
  52:Core/Src/bmp280.c **** Configure the ctrl_meas(addr 0xF4) and config(addr 0xF5) with the appropriate settings.
  53:Core/Src/bmp280.c **** ctrl_meas - 0xF4 params:
  54:Core/Src/bmp280.c ****     osrs_t[2:0] -> Oversampling setting for temperature
  55:Core/Src/bmp280.c ****     osrs_p[2:0] -> Oversampling setting for pressure
  56:Core/Src/bmp280.c ****     mode[1:0] -> Power setting
  57:Core/Src/bmp280.c **** config - 0xF5 params:
  58:Core/Src/bmp280.c ****     t_sb[2:0] -> Standby time setting. This will control the time between pressure readings.
  59:Core/Src/bmp280.c ****     filter[2:0] -> IIR filter settings
  60:Core/Src/bmp280.c ****     spi3w_en -> bit that enables 3 wire spi mode
  61:Core/Src/bmp280.c **** Codes for different function outputs:
  62:Core/Src/bmp280.c **** 
  63:Core/Src/bmp280.c **** */
