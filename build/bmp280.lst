   1:Core/Src/bmp280.c **** /*
   2:Core/Src/bmp280.c **** This is where the code for interfacing with the BMP280 barometer.
   3:Core/Src/bmp280.c **** Functions contained:
   4:Core/Src/bmp280.c ****     - BMP280_READ_PRESSURE()
   5:Core/Src/bmp280.c ****     - BMP280_READ_TEMPERATURE()
   6:Core/Src/bmp280.c ****     - BMP280_READ(uint8_t read_addr)
   7:Core/Src/bmp280.c ****     - BMP280_WRITE(uint8_t write_addr, uint8_t write_val)
   8:Core/Src/bmp280.c ****     - BMP280_Config(uint8_t config_byte)
   9:Core/Src/bmp280.c **** 
  10:Core/Src/bmp280.c **** Also contains functions to parse the pressure and temp data
  11:Core/Src/bmp280.c ****     - BMP280_PARSE_TEMPERATURE(uint8_t raw_temperature)
  12:Core/Src/bmp280.c ****     - BMP280_PARSE_PRESSURE(uint8_t raw_pressure)
  13:Core/Src/bmp280.c **** 
  14:Core/Src/bmp280.c **** Most of the interfacing with this module is either config or reading from registers.
  15:Core/Src/bmp280.c **** 
  16:Core/Src/bmp280.c **** Note: The HAL SPI functions have bus guards in place already, so we don't need to implement them ou
  17:Core/Src/bmp280.c **** */
